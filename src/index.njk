{% from "macros.njk" import label %}

<nav class="toc" aria-label="目次">
  <p class="toc-title">目次</p>
  <ul class="toc-list">
    <li><a href="#news">最新情報</a></li>
    <li><a href="#about-labels">確認ラベルの意味</a></li>
