    <input id="hb-dam-input" class="combobox-input" type="search" autocomplete="off" enterkeyhint="search" aria-autocomplete="list" aria-controls="hb-dam-list">
    <ul id="hb-dam-list" class="combobox-list" role="listbox" hidden></ul>
  </div>
